# Copy to .env for local use. On Render/Vercel set these in the dashboard instead.
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=choose-a-long-unique-password
JWT_SECRET=paste-a-long-random-string-here
# Only needed when the frontend is on a different domain (e.g. Vercel). Comma-separate several.
FRONTEND_ORIGIN=https://your-site.vercel.app
# Where site.json and uploaded images are stored (use a persistent disk path on Render)
# DATA_DIR=/var/data
